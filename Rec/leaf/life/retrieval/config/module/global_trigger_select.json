      "trigger_label_weight_map": ["global_trigger_label_weight_map_str", ""],
      "trigger_min_cluster_size": ["global_trigger_min_cluster_size", 20],
      "normal_trigger_num": ["global_trigger_normal_trigger_num", 500],
      "high_value_trigger_num": ["global_trigger_high_value_trigger_num", 100],
      "enable_normal_shuffle": ["global_trigger_enable_normal_shuffle", false],
      "negative_trigger_min_weight": ["global_trigger_filter_negative_trigger_min_weight", 0.0],
      "append_prefer_trigger_num": ["global_trigger_append_prefer_trigger_num", 0],

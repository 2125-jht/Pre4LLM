      },
      "hetu_level2_tags": {
        "kconf_key": "reco.offline.exploreHetuTagToLevel2JsonMap",
        "value_type": "json",
        "json_path": "level2_tags"
      },
      "life_restrict_hetu_level1": {
        "kconf_key": "reco.offline.life_restrict_hetu_level1",
        "value_type": "list_int64",
        "default_value": []
      }
    },
    "import": {
      "common_attrs": [
        "user_info_ptr",
        "colossus_resp_v2",
        "hetu_v1_id_mapping_ptr",
        "negative_trigger_ids",
        "negative_trigger_weights",
        "prefer_trigger_ids",
        "prefer_trigger_weights"

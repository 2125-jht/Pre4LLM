      "trigger_weight_adjust_coef": ["global_trigger_weight_adjust_coeff", 1.0],
      "trigger_weight_max_value": ["global_trigger_weight_max_value", 1.0],
      "use_fountain_playstat": ["explore_golbal_trigger_use_fountain_playstat", false],
      "use_fountain_action_list": ["explore_golbal_trigger_use_fountain_action_list", false],
      "playstat_trigger_play_time_ths": ["explore_golbal_trigger_playstat_trigger_play_time_ths", 7],
      "enable_life_hetu_restrict": ["enable_life_hetu_restrict", 1],

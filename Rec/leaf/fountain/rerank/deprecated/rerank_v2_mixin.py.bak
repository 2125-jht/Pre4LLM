  def gen_list_rerank_distill(self):
    self \
    .sort(
      score_from_attr = "fullrank_rerank_distill_score",
    ) \
    .gen_original_sequence(
      item_type = 3,
      reason = 10,
      sequence_length = 6,
      output_sequence_attr_name = "generated_diversity_lists",
    ) \
    .pack_common_attr(
      input_common_attrs = ["retrieval_list_keys", "retrieval_list_keys_10"],
      output_common_attr = 'retrieval_list_keys',
      deduplicate = True
    ) \
    .sort(
      score_from_attr = "item_seq",
      desc = False
    )

    return self
    
  def gen_list_rerank_point(self):
    self \
    .sort(
      score_from_attr = "fullrank_rerank_gen_point_pos_score",
    ) \
    .gen_original_sequence(
      item_type = 3,
      reason = 11,
      sequence_length = 6,
      output_sequence_attr_name = "generated_diversity_lists",
    ) \
    .pack_common_attr(
      input_common_attrs = ["retrieval_list_keys", "retrieval_list_keys_11"],
      output_common_attr = 'retrieval_list_keys',
      deduplicate = True
    ) \
    .sort(
      score_from_attr = "item_seq",
      desc = False
    )
    return self

  def write_rerank_pos_result_to_redis(self):
    self \
    .if_("fountain_enable_rerank_select_rerank_pos_result == 1", to_be_delete = "date=2024-05-29;committer=liuhao07") \
      .enrich_attr_by_light_function(
        import_common_attr = [
          {"name": "fountain_select_rerank_pos_result_target_count", "as": "target_count"},
        ],
        import_item_attr = [
          "photo_id",
          {"name": "fullrank_sim_pfintr", "as": "pwatch_time"}
        ],
        export_common_attr = [
          {"name": "target_pids", "as": "rerank_pos_photo_id_list"}
        ],
        function_name = "FountainSelectRerankPosPids",
        class_name = "ExploreLightFunctionSetV2",
        range_start = "{{fountain_rerank_pos_photo_start_index}}",
        range_end = "{{fountain_rerank_pos_photo_end_index}}"
      ) \
    .else_() \
      .pack_item_attr(
        item_source = {
          "reco_results": True
        },
        mappings = [{
          "from_item_attr": "photo_id",
          "to_common_attr": "rerank_pos_photo_id_list",
          "aggregator": "concat"
        }],
        range_start = "{{fountain_rerank_pos_photo_start_index}}",
        range_end = "{{fountain_rerank_pos_photo_end_index}}"
      ) \
    .end_() \
    .enrich_attr_by_light_function(
      import_common_attr = [
        {"name": "rerank_pos_photo_id_list", "as": "universal_set_list"},
        {"name": "fountain_rerank_pos_photo_id_retrieval_list", "as": "sub_set_list"}
      ],
      export_common_attr = [
        {"name": "difference_list", "as": "rerank_pos_photo_id_list"}
      ],
      function_name = "GetDifferenceSet",
      class_name = "ExploreLightFunctionSetV2",
    ) \
    .pack_common_attr(
      input_common_attrs = [
        "rerank_pos_photo_id_list",
        "fountain_rerank_pos_photo_id_retrieval_list"
      ],
      output_common_attr = "rerank_pos_photo_id_list",
      deduplicate = True,
      limit_num = "{{fountain_rerank_pos_photo_size}}",
    ) \
    .write_to_redis(
      kcc_cluster = "recoExploreNegPhoto",
      timeout = 10,
      expire_second = "{{fountain_rerank_pos_photo_redis_expire_seconds}}",
      key_prefix = "{{fountain_rerank_pos_photo_key_prefix}}",
      key = "{{_USER_ID_}}",
      value = "{{rerank_pos_photo_id_list}}"
    )
    return self

  def write_rerank_neg_result_to_redis(self):
    self \
    .if_("fountain_enable_rerank_select_rerank_neg_result == 1", to_be_delete = "date=2024-05-29;committer=liuhao07") \
      .enrich_attr_by_light_function(
        import_common_attr = [
          {"name": "fountain_rerank_neg_photo_target_ratio", "as": "target_ratio"},
        ],
        import_item_attr = [
          {"name": "rank_final_index", "as": "before_index"},
          {"name": "rerank_final_index", "as": "after_index"},
          "photo_id"
        ],
        export_common_attr = [
          {"name": "target_pids", "as": "rerank_neg_photo_id_list"},
        ],
        function_name = "SelectRecoNegPids",
        class_name = "ExploreLightFunctionSetV2",
        range_start = "{{fountain_rerank_neg_photo_start_index}}"
      ) \
    .else_() \
      .pack_item_attr(
        item_source = {
          "reco_results": True
        },
        mappings = [{
          "from_item_attr": "photo_id",
          "to_common_attr": "rerank_neg_photo_id_list",
          "aggregator": "concat"
        }],
        range_start = "{{fountain_rerank_neg_photo_start_index}}",
        range_end = "{{fountain_rerank_neg_photo_end_index}}"
      ) \
    .end_() \
    .pack_common_attr(
      input_common_attrs = [
        "rerank_neg_photo_id_list",
        "rerank_neg_photo_id_filter_list"
      ],
      output_common_attr = "rerank_neg_photo_id_list",
      deduplicate = True,
      limit_num = "{{fountain_rerank_neg_photo_size}}",
    ) \
    .write_to_redis(
      kcc_cluster = "recoExploreNegPhoto",
      timeout = 10,
      expire_second = "{{fountain_rerank_neg_photo_redis_expire_seconds}}",
      key_prefix = "{{fountain_rerank_neg_photo_key_prefix}}",
      key = "{{_DEVICE_ID_}}",
      value = "{{rerank_neg_photo_id_list}}"
    )
    return self

  def calc_result_count_to_ab_metric(self):
    return self \
      .cast_attr_type(
        attr_type_cast_configs=[
          {
            "to_type": "double",
            "from_item_attr": "rank_final_index",
            "to_item_attr": "rank_final_index_double"
          }
        ]
      ) \
      .pack_item_attr(
        item_source = {
          "reco_results": True,
          "total_limit": 10,
        },
        mappings = [
          {
            "aggregator": "avg",
            "from_item_attr": "rank_final_index_double",
            "to_common_attr": "fountain_rerank_top10_rank_index_avg"
          },
        ]
      )

      .end_if_() \
    .end_if_() \
    .if_("fountain_rerank_enable_shuffle_gen_list == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .shuffle_list_attr(
        common_attr = "retrieval_list_keys"
      ) \
    .end_()
    
    return self
    
  def dpp_process(self):
    self \
    .if_("fountain_rerank_enable_diversity_page_enhance == 1") \
      .if_("page ~= nil and page > fountain_rerank_diversity_page_enhance_start") \
        .gen_common_attr_by_lua(
          attr_map={
            "fountain_rerank_dpp_diversity_rank_theta": "fountain_rerank_dpp_diversity_rank_theta * fountain_rerank_diversity_page_enhance_coeff",
            "fountain_ssd_rank_score_weight": "fountain_ssd_rank_score_weight * fountain_rerank_diversity_page_enhance_coeff",
        }) \
      .end_() \
    .end_() \
    .dpp_gen_sequence(
      fix_diversity_score="{{enable_fountain_rerank_fix_diversity_score}}",
      max_sequence_num="{{fountain_rerank_dpp_diversity_max_sequence_num}}",
      return_item_type=3,
      queues=gen_seed_ensemble_queues_dpp_v2(),
      embedding_service_name="{{fountain_rerank_dpp_diversity_embedding_service_name}}",
      dpp_diversity_shard_num="{{fountain_rerank_dpp_diversity_shard_num}}",
      embedding_slot_id="{{fountain_rerank_dpp_diversity_embedding_slot_id}}",
      embedding_sign_format="{{fountain_rerank_dpp_diversity_embedding_sign_format}}",
      embedding_timeout_ms="{{fountain_rerank_dpp_diversity_embedding_timeout_ms}}",
      embedding_format="{{fountain_rerank_dpp_diversity_embedding_format}}",
      keep_pre_size="{{fountain_rerank_keep_pre_size}}",
      the_temperature="{{fountain_rerank_dpp_proportion_temperature}}",
      use_power_rank="{{fountain_rerank_dpp_use_power_rank}}",
      use_proportion="{{fountain_rerank_dpp_use_proportion}}",
      the_temperature_addAndMul="{{fountain_rerank_dpp_proportion_temperature_addAndMul}}",

  def gen_avg_xtr_score(self):
    self \
    .enrich_attr_by_light_function(
      import_item_attr = [
       "view_length_sum", "click_count"
      ],
      export_item_attr = [
        "fullrank_emp_avg_play_score",
      ],
      function_name = "CalAvgPlayScore",
      class_name = "ExploreLightFunctionSetV2",
    ) \
    .pack_item_attr(
      item_source={
        "reco_results": True,
      },
      mappings=[
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_click_score",
          "to_common_attr": "avg_click_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_like_score",
          "to_common_attr": "avg_like_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_follow_score",
          "to_common_attr": "avg_follow_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_forward_score",
          "to_common_attr": "avg_forward_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_collect_score",
          "to_common_attr": "avg_collect_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_comment_score",
          "to_common_attr": "avg_comment_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_pfintr_score",
          "to_common_attr": "avg_pfintr_dev"
        },
        {
          "aggregator": "avg",
          "from_item_attr": "fullrank_emp_avg_play_score",
          "to_common_attr": "avg_play_dev"
        },
      ]
    ) \

    return self

  def gen_unexpected_queue(self):
    self \
    .explore_rerank_attr(
      user_info_attr = "userInfoPb"
    ) \
    .explore_common_user_feature_enricher(
      user_info_attr = "userInfoPb",
      user_effective_view_pids_attr = "explore_effective_pids",
      ft_ev_pids_attr = "fountain_effective_pids",
    ) \
    .concat_attr(
      input_common_attrs = [
        "explore_effective_pids", "fountain_effective_pids"
      ],
      output_common_attr = "effective_pids",
    ) \
    .get_remote_embedding_lite(
      kess_service = "grpc_MMUHetuSimContentEmbedding",
      shard_num = 4,
      id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
      output_attr_name = "pids_emb",
      size = 64,
      client_side_shard = True
    ) \
    .get_remote_embedding_lite(
      kess_service = "grpc_MMUHetuSimContentEmbedding",
      shard_num = 4,
      id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
      input_attr_name = "effective_pids",
      output_attr_name = "effective_embedding_pids",
      query_source_type = "common_attr",
      size = 64,
      client_side_shard = True
    ) \
    .kmeans_cluster_action_list(
      cluster_center_size = 5,
      kmeans_verbose = False,
      embedding_dim = 64,
      action_list_id_common_attr_name = "effective_pids",
      action_list_emb_common_attr_name = "effective_embedding_pids",
      cluster_center_size_common_attr_name = "cluster_num_list",
      cluster_center_list_emb_common_attr_name = "cluster_embedding_list",
      output_truncate = False)  \
    .enrich_attr_by_light_function(
      import_common_attr = [
        "cluster_num_list",
        "cluster_embedding_list",
        "fountain_unexpected_emb_dim",
      ],
      import_item_attr = [
        "pids_emb"
      ],
      export_item_attr = [
        "fullrank_unexpected_score"
      ],
      function_name = "CalEmbScore",
      class_name = "ExploreLightFunctionSetV2",
    ) \

    return self

  def gen_cluster_id_rate(self):
    self \
    .enrich_attr_by_light_function(
      import_common_attr = [
        "uOldMmuClusterId300ListList",
        {"name": "fountain_rerank_dpp_cid_upper_bound", "as": "cluster_id_cid_rate_upper_bound"},
        {"name": "fountain_rerank_dpp_cid_lower_bound", "as": "cluster_id_cid_rate_lower_bound"},
        {"name": "fountain_rerank_dpp_cid_avg_bound", "as": "cluster_id_cid_rate_avg_bound"},
      ],
      export_common_attr = [
        {"name": "cid_rate", "as": "fountain_colossus_hetu_personalized_score"}, #取值范围为0.03，使用的时候可以加权
      ],

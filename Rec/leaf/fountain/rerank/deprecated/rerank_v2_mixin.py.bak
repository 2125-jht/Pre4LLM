  def gen_duration_xtr_score(self):
    self \
    .explore_duration_xtr_debias_enricher(
      duration_xtr_debias_user_add = "{{rerank_gen_duration_pxtr_cal_add}}",
      duration_xtr_debias_window_size = "{{rerank_gen_duration_pxtr_window_size}}",
      enable_use_bidirectional_window = "{{rerank_gen_duration_pxtr_use_bidirectional_window}}",
      duration_xtr_debias_score_que_attr = "rerank_gen_duration_pxtrs_bias_score",
      duration_ms_attr = "duration_ms",
      enable_sort_by_duration = "{{rerank_gen_duration_pxtr_enable_sort_by_duration}}",
      queues = rerank_duration_xtr_queues
    ) \

    return self

  def gen_vv_xtr_score(self):
    self \
    .explore_duration_xtr_debias_enricher(
      duration_xtr_debias_user_add = "{{rerank_gen_vv_pxtr_cal_add}}",
      duration_xtr_debias_window_size = "{{rerank_gen_vv_pxtr_window_size}}",
      enable_use_bidirectional_window = "{{rerank_gen_vv_pxtr_use_bidirectional_window}}",

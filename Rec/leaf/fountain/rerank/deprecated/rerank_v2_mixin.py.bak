      pxtr_matrix_col_zero_centered="{{fountain_pxtr_matrix_col_zero_centered}}",
      sim_matrix_pxtr_emb=pxtr_matrix_combo_queues,
      rank_score_type="{{fountain_dpp_rank_score_type}}",
      enable_new_variety_engineer="{{fountain_rerank_enable_new_variety_engineer}}",
      max_satisfied_pick="{{fountain_rerank_variety_engineer_satisfied_num}}",
      rules = get_dpp_rule_dict(),
      dpp_core_attr_except_embedding=[
        {
          "name_attr": "duration_ms",
          "weight_attr": "dpp_core_duration_ms_weight",
          "max_value_attr": "dpp_core_duration_ms_max_value",
          "min_value_attr": "dpp_core_duration_ms_min_value"
        }
      ],
      enable_marketing_compensation_photo_discount = "{{fountain_enable_rerank_marketing_compensation_photo_discount}}",
      marketing_compensation_photo_discount_coeff = "{{fountain_rerank_marketing_compensation_photo_discount_coeff}}",
      marketing_compensation_photo_attr = "is_marketing_compensation_photo",
      marketing_compensation_photo_adjust_version = "{{fountain_enable_rerank_marketing_compensation_photo_adjust_version}}",
      marketing_compensation_photo_scale_factor = "{{fountain_enable_rerank_marketing_compensation_photo_scale_factor}}",
      marketing_compensation_photo_reward_coeff_attr = "rank_marketing_compensation_coeff"
    )
    return self

  def rerank_truncate(self):
    self \
    .switch_("fountain_rerank_truncate_switch_method") \
      .case_(1, to_be_delete = "date=2024-05-29;committer=huzengyi") \
        .sort(
          score_from_attr = "fullrank_distill_rerank_score",
        ) \
      .case_(2, to_be_delete = "date=2024-05-29;committer=huzengyi") \
        .sort(
          score_from_attr = "fullrank_distill_fusion_score",
          range_end = "{{fountain_re_sort_by_distill_fusion_num}}",
        ) \
      .case_(3, to_be_delete = "date=2024-05-29;committer=huzengyi") \
        .sort(
          score_from_attr = "fullrank_rrwtd_score",
          range_end = "{{fountain_re_sort_by_distill_fusion_num}}",
        ) \
    .end_() \
    .enrich_attr_by_lua(
      import_item_attr=[
        "duration_ms"
      ],
      export_item_attr=[
        "duration_0_7s",
        "duration_7_9s",
        "duration_9_12s",
        "duration_12_17s",
        "duration_17_20s",
        "duration_20_58s",
        "duration_58_120s",
        "duration_gt_120s",
        "score_before_rerank"
      ],
      function_for_item="duration_change",
      lua_script_file="fountain/rerank/lua/all_lua.lua",
    ) \
    .copy_attr(
      attrs=[{
        "from_item": "score_before_rerank",
        "to_item": "fullrank_rank_before_rerank_score"
      }]
    ) \
    .if_("fountain_rerank_cut_skip_diversity == 0", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .diversify_by_rules(
        max_satisfied_pick="{{fountain_rerank_limit_size_produce_v4}}",
        rules=before_rerank_diversity_rules,
        range_start="{{fountain_rerank_cut_range_start}}"
      ) \
    .end_() \
    .if_("fountain_fullrank_enable_dpp_control == 1", to_be_delete = "date=2024-05-29;committer=xuwei09") \
      .get_remote_embedding_lite(
        kess_service = "grpc_MMUHetuSimContentEmbedding",
        shard_num = 4,
        id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
        output_attr_name = "fullrank_mmu_emb",
        size = 64,
        client_side_shard = True,
        range_end = "{{fountain_fullrank_dpp_control_range_end}}"
      ) \
      .get_remote_embedding_lite(
        kess_service = "grpc_hotMcEmbed",
        shard_num = 8,
        id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
        output_attr_name = "fullrank_mc_emb",
        size = 128,
        client_side_shard = True,
        range_end = "{{fountain_fullrank_dpp_control_range_end}}"
      ) \
      .explore_dpp_set_arranger(
        beam_size = 1,
        dpp_max_num = 60,
        mmu_emb_attr_name = "fullrank_mmu_emb",
        mc_emb_attr_name = "fullrank_mc_emb",
        rank_theta = "{{fountain_fullrank_dpp_rank_theta}}",
        enable_only_max_dpp_score_list = "{{fountain_fullrank_dpp_enable_only_max_dpp_score_list}}",
        enable_norm_sim_matrix = "{{fountain_fullrank_dpp_enable_norm_sim_matrix}}",
        sim_matrix_combo_alpha = "{{fountain_fullrank_dpp_sim_matrix_combo_alpha}}",
        sim_matrix_norm_type = "{{fountain_fullrank_dpp_sim_matrix_norm_type}}",
        range_end = "{{fountain_fullrank_dpp_control_range_end}}"
      ) \
    .end_()

    return self


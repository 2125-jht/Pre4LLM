  def model_gen_list(self):
    self \
    .split_string(
      input_common_attr="fountain_rerank_predict_service_loss_name_prefix",
      output_common_attr="fountain_rerank_predict_service_loss_name_prefix_strs",
      delimiters=";",
    ) \
    .common_predict(
      loss_function_name=["pos" + str(i) for i in range(6)] + ["next" + str(i) for i in range(6)],
      loss_default_value=0.0,
      kess_service="{{fountain_rerank_kai_set_evaluator_service}}",
      service_group="PRODUCTION",
      timeout_ms=100,
      attr_name_transform_map=rerank_feature_map_new,
      extra_common_attrs=rerank_extra_common_attr(),
      item_attrs=gen_photo_features_for_all_position_new(6),
      item_list_from_attr="retrieval_list_keys"
    ) \
    .enrich_attr_by_light_function(
      export_item_attr=["fullrank_sim_pevtr", "fullrank_sim_pfintr", "fullrank_sim_pvtr", "fullrank_pfintr_norm_score",
                        "fullrank_action_once_interact_score"],
      function_name="EmptyFunction",
      class_name="ExploreLightFunctionSetV2",
      item_list_from_attr="retrieval_list_keys"
    ) \
    .explore_model_greedy_gen_list_enricher(
      item_attrs=["pos" + str(i) for i in range(6)] + ["next" + str(i) for i in range(6)],
      loss_name="fountain_rerank_predict_service_loss_name_prefix_strs",
      seq_item_attr_name="generated_diversity_lists",
      output_attr="retrieval_list_keys_8",
      output_score_attr="rerank_context",
      use_beamsearch="{{fountain_model_gen_list_use_beamsearch}}",
      pnext_alpha="{{fountain_model_gen_list_pnext_alpha}}",
      pnext_beta="{{fountain_model_gen_list_pnext_beta}}",
      beam_size="{{fountain_model_gen_list_beam_size}}",
      use_watchtime_predict="{{fountain_model_gen_list_use_watchtime_predict}}",
      use_watchtime_duration_trans="{{fountain_model_gen_list_use_watchtime_duration_trans}}",
      value_weight="fountain_model_gen_list_value_weight",
      next_weight="fountain_model_gen_list_next_weight",
      watchtime_weight="fountain_model_gen_list_watchtime_weight",
      duration_ms_attr="duration_ms",
      watchtime_attr="watchtime",
      extra_pxtr_attr=model_greedy_extra_queues,
      return_item_type=4,
      item_list_from_attr="retrieval_list_keys"
    ) \
    .pack_common_attr(
      input_common_attrs=["retrieval_list_keys", "retrieval_list_keys_8"],
      output_common_attr='retrieval_list_keys',
      deduplicate=True
    ) \
    .if_("fountain_skip_rerank_predict_v2 == 0 or fountain_skip_rerank_predict_with_new_attr == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .list_wise_seq_attr(
        upload_time_attr="upload_time",
        duration_ms_attr="duration_ms",
        hetu_level_one_attr="hetu_tag_level_info__hetu_level_one",
        hetu_level_two_attr="hetu_tag_level_info__hetu_level_two",
        hetu_level_three_attr="hetu_tag_level_info__hetu_level_three",
        hetu_level_four_attr="hetu_tag_level_info__hetu_level_four",
        hetu_level_five_attr="hetu_tag_level_info__hetu_level_five",
        item_attrs_transform_map=rerank_features,
        seq_item_attr_name="generated_diversity_lists",
        output_attrs=gen_photo_features_for_all_position_new(6),
        item_list_from_attr="retrieval_list_keys_8",
      ) \
    .end_()

    return self

  
  def full_link_distill_sample(self):
    self \
    .get_kconf_params(
      kconf_configs=[
        {
          "kconf_key": "reco.offline.fountainFulllinkDistillRankParam",
          "value_type": "json",
          "json_path": "rerank_full_link_distill_sample_begin",
          "export_common_attr": "fountain_rerank_full_link_distill_sample_begin"
        },
        {
          "kconf_key": "reco.offline.fountainFulllinkDistillRankParam",
          "value_type": "json",
          "json_path": "rerank_full_link_distill_sample_end",
          "export_common_attr": "fountain_rerank_full_link_distill_sample_end"
        },
        {
          "kconf_key": "reco.offline.fountainFulllinkDistillRankParam",
          "value_type": "json",
          "json_path": "rerank_full_link_distill_sample_num",
          "export_common_attr": "fountain_rerank_full_link_distill_sample_num"
        },
        {
          "kconf_key": "reco.offline.fountainFulllinkDistillRankParam",
          "value_type": "json",
          "json_path": "rerank_full_link_distill_sample_ratio",
          "export_common_attr": "fountain_rerank_full_link_distill_sample_ratio"
        },
      ]
    ) \
    .explore_full_link_context_sample_reco_log_enricher(
      sample_config = [
        {
          "sample_begin": "fountain_rerank_full_link_distill_sample_begin",
          "sample_end": "fountain_rerank_full_link_distill_sample_end",
          "sample_num": "fountain_rerank_full_link_distill_sample_num",
          "label_name": "final_pos",
        },
      ],
      sample_ratio = "fountain_rerank_full_link_distill_sample_ratio",
      user_info_attr = "userInfoPb",
      load_attr = "fountain_full_link_reco_log_message",
      save_result_to = "fountain_full_link_reco_log_message_final",
      rank_index = "rank_index_after_es",
      final_index = "item_seq",
      cascade_pctr = "cascade_pctr",
      cascade_pltr = "cascade_pltr",
      cascade_pwtr = "cascade_pwtr",
      cascade_pftr = "cascade_pftr",
      cascade_pptr = "cascade_ptr",
      cascade_pcmtr = "cascade_pcmtr",
      cascade_plvtr = "cascade_plvtr",
      cascade_pvtr = "cascade_pwatch_time",
      pctr = "fullrank_sim_pevtr",
      pltr = "fullrank_sim_pltr",
      pwtr = "fullrank_sim_pwtr",
      pftr = "fullrank_sim_pftr",
      pptr = "fullrank_sim_pptr",
      pcmtr = "fullrank_sim_pcmtr",
      plvtr = "fullrank_sim_plvtr",
      pvtr = "fullrank_sim_pvtr",
      size_limit = 60,
    ) \
    .send_with_kafka(
      common_attr = "fountain_full_link_reco_log_message_final",
      topic_name = "full_link_samples",
    ) \

    return self

  def cal_expected_value_gen_list(self):
    self \
    .fountain_calc_ensemble_score(
      save_score_to_attr = "rerank_expected_value_score",
      user_power_calc_v2 = "{{fountain_rerank_expected_value_enable_power_calc_v2}}",
      use_rank_with_absolute_score = 0,
      use_xtr_weight_raw_score = "{{fountain_rerank_expected_value_use_xtr_weight_raw_score}}",
      queues = rerank_expected_value_queues,
    ) \
    .explore_mdp_gen_list_enricher(
      candidate_size = "{{fountain_mdp_gen_list_candidate_size}}",
      output_len = "{{fountain_mdp_gen_list_output_len}}",
      item_value_attr_name = "rerank_expected_value_score",
      item_next_attr_name = "fullrank_ltr_v4_fountain_next",
      output_attr = "retrieval_list_keys_9",
      pnext_alpha = "{{fountain_mdp_gen_list_pnext_alpha}}",
      pnext_beta = "{{fountain_mdp_gen_list_pnext_beta}}",
      beam_size = "{{fountain_mdp_gen_list_beam_size}}",
      value_mean = "{{fountain_mdp_gen_list_value_mean}}",
      seq_item_attr_name = "generated_diversity_lists",
      return_item_type = 3,
    ) \
    
    return self
    
  def final_es_sort(self):
    self \
    .enrich_attr_by_light_function(
      export_item_attr=['fullrank_act_ctr', 'fullrank_act_wtd', 'fullrank_action_once_interact_score',
                        'fullrank_action_once_watchtime_score', 'fullrank_ada_xtr_score', 'fullrank_detail_new_pevtr_v2',
                        'fullrank_ensemble_score', 'fullrank_ltr_v4_fountain_finish_rate', 'fullrank_sim_lstr',
                        'fullrank_sim_pcltr', 'fullrank_sim_pcmef', 'fullrank_sim_pcmtr', 'fullrank_sim_pcpr',
                        'fullrank_sim_pepstr', 'fullrank_sim_pevtr', 'fullrank_sim_pfintr', 'fullrank_sim_pftr',
                        'fullrank_sim_pltr', 'fullrank_sim_plvtr', 'fullrank_sim_pptr', 'fullrank_sim_pwtr',
                        'fullrank_trans_pvtr_score'],
      function_name="EmptyFunction",
      class_name="ExploreLightFunctionSetV2",
    ) \
    .fountain_calc_ensemble_score(
      save_score_to_attr="rerank_point_final_score",
      user_new_proportion="{{fountain_rerank_ensemble_score_user_new_proportion}}",
      user_power_calc="{{fountain_rerank_ensemble_score_enable_power_calc}}",
      rank_smooth="{{fountain_rerank_ensemble_score_rank_smooth}}",
      use_reciprocal="{{fountain_rerank_ensemble_score_use_reciprocal}}",
      user_info_ptr_attr="userInfoPb",
      action_day="{{fountain_rerank_ensemble_score_action_day_num}}",
      queues=rerank_ensemble_queues,
    ) \
    .sort(
      stable_sort=True,
      score_from_attr="rerank_point_final_score",
      range_end=6
    )

    return self

  def post_process(self):
    self.calc_result_count_to_ab_metric()
    self \
    .log_debug_info(
      item_attrs = [
        "fullrank_pfintr_norm_score"
      ],
      for_debug_request_only = True
    ) \
    .log_debug_info(
      item_attrs = [
        "virtual_rerank_score"
      ],
      for_debug_request_only = True,
      item_list_from_attr="retrieval_list_keys"
    ) \
    .log_debug_info(
      item_attrs = gen_photo_features_for_all_position_new(6),
      for_debug_request_only = True,
      item_list_from_attr="retrieval_list_keys_8"
    )

    return self


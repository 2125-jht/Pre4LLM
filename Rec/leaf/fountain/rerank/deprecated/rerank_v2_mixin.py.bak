#!/usr/bin/env python3
# coding=utf-8
from dragonfly.ext.tdm.tdm_api_mixin import TDMApiMixin
from dragonfly.ext.explore.explore_api_mixin import ExploreApiMixin
from dragonfly.ext.subdivision.subdivision_api_mixin import subdivisionApiMixin
from rerank.ab_params import gen_rerank_abtest, abtest_is_or_not_rerank, gen_rerank_ab_hit_abtest
from rerank.rerank_base import gen_variant_config2, gen_variant_config
from rerank.rerank_base import gen_photo_features_for_all_position_new, gen_list_predict_common_attrs
from rerank.rerank_base import gen_list_ensemble_filter_queues, gen_seed_ensemble_queues_dpp_v2
from rerank.rerank_base import rerank_ensemble_queues, pos_features
from rerank.rerank_base import before_rerank_diversity_rules, pxtr_matrix_combo_queues, model_greedy_extra_queues,rerank_hetu_ensemble_queues, rerank_expected_value_queues, rerank_cid_ensemble_queues
from rerank.rerank_base import rerank_item_features, rerank_user_features, rerank_duration_xtr_queues, rerank_vv_xtr_queues, rerank_cid_xtr_queues
from rerank.rerank_base import rerank_features, rerank_feature_map_all, rerank_feature_map, rerank_feature_map_new, rerank_extra_common_attr, rr_wtd_table_common_attr, rr_duration_item_attr
from rerank.rerank_base import get_dpp_rule_dict
from full_rank.fullrank_base_features import item_features, item_features_rerank, user_features, rerank_listwise_distill_item_features,rr_photo_features,rr_user_feature, rerank_features_fulllink, user_features_fulllink
from util import enrich_ab_param

class ReRankV2Mixin(subdivisionApiMixin, ExploreApiMixin, TDMApiMixin):
  def rerank_v2(self):
    self \
    .get_abtest_params(
      biz_name="RECO_RPC",
      ab_params=enrich_ab_param(gen_rerank_abtest()),
      prioritized_suffix = "{{_ABTEST_SUFFIX_LIST_}}"
    ) \
    .get_abtest_params(
      biz_name = "RECO_RPC",
      ab_params = gen_rerank_ab_hit_abtest() + abtest_is_or_not_rerank,
      prioritized_suffix = "{{_ABTEST_SUFFIX_LIST_}}"
    ) \
    .if_("enable_insert_fountain_fullrank_similar_photo == 1") \
      .pack_item_attr(
        item_source = {
          "reco_results": True
        },
        mappings = [{
          "from_item_attr": "photo_id",
          "to_common_attr": "fullrank_total_photo_id_list",
          "aggregator": "concat"
        }],
      ) \
    .end_if_() \
    .if_("enable_use_fountain_rerank == 1") \
    .if_("skip_fountain_rerank_limit == 0") \
      .rerank_truncate() \
    .end_if_() \
    .if_("fountain_enable_cascade_distill_sample == 1") \
      .copy_item_meta_info(
        save_item_seq_to_attr="item_seq"
      ) \
    .end_() \
    .enrich_attr_by_light_function(
      import_item_attr = [
        "explore_stat__real_show_count",
        "explore_stat__click_count",
        "explore_stat__like_count",
        "explore_stat__follow_count",
        "explore_stat__forward_count",
        "explore_stat__long_play_count",
        "explore_stat__short_play_count",
        "explore_stat__profile_enter_count",
        "explore_stat__negative_count",
        "explore_stat__comment_count",
        "explore_stat__view_length_sum",
        "is_picture",
      ],
      export_item_attr = [
        "empirical_ctr",
        "empirical_ltr",
        "empirical_wtr",
        "empirical_ftr",
        "empirical_ptr",
        "empirical_htr",
        "empirical_cmtr",
        {"name": "empirical_watch_time", "as": "empirical_watchtime"}
      ],
      function_name = "McCalEmpiricalXtr",
      class_name = "ExploreLightFunctionSetV2",
    ) \
    .if_("fountain_rerank_enable_gen_model_sum == 1 or fountain_rerank_enable_gen_model_beam == 1") \
       .enrich_fulllink_kai2_feature() \
    .end_() \
    .if_("fountain_rerank_enable_gen_model_sum == 1") \
       .rerank_gen_model_sum() \
    .end_() \
    .if_("fountain_rerank_enable_gen_model_beam == 1", to_be_delete = "date=2024-05-29;committer=renyuxin") \
       .rerank_gen_model_beam() \
    .end_() \
    .if_("fountain_rerank_enable_jarvis_param > 0", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .jarvis_handle() \
    .end_if_() \
    .if_("enable_cal_user_group_emp_xtr_in_rerank == 1") \
      .cal_user_group_emp_xtr_all_rerank() \
    .end_if_() \
    .if_("enable_cal_user_group_dynamic_weight_in_rerank == 1", to_be_delete = "date=2024-05-29;committer=xuwei09") \
      .cal_user_group_dynamic_weight() \
    .end_if_() \
    .if_("enable_fountain_cal_share_pull_ftr_rerank == 1") \
      .cal_share_pull_ftr_rerank() \
    .end_if_() \
    .if_("fountain_rerank_use_emp_xtr_adaptive_weight == 1") \
      .emp_xtr_ada() \
    .end_if_() \
    .if_("fountain_rerank_use_request_xtr_dev_adaptive_range == 1", to_be_delete = "date=2024-05-29;committer=xuwei09") \
      .request_xtr_dev() \
    .end_if_() \
    .if_("fountain_enable_rerank_user_dynamic_play_ratio_weights == 1") \
      .cal_rerank_user_dynamic_play_ratio_weights() \
    .end_if_() \
    .if_("fountain_enable_sim_matrix_combo == 1") \
      .if_("fountain_sim_matrix_combo_enable_get_mmu_emb == 0") \
        .get_remote_embedding_lite(
          kess_service="{{fullrank_emb_kess_name_for_dpp_emb}}",
          shard_num=8,
          id_converter={"type_name": "kuibaEmbeddingIdConverter"},
          output_attr_name="dpp_emb",
          size=128,
          client_side_shard=True
        ) \
      .else_() \
        .get_remote_embedding_lite(
          kess_service = "{{fullrank_mmu_emb_kess_name_for_dpp_emb}}",
          shard_num = 4,
          id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
          output_attr_name = "dpp_emb",
          size = 64,
          client_side_shard = True
        ) \
      .end_if_() \
    .end_if_() \
    .if_("fountain_rerank_enable_session_ssd == 1", to_be_delete = "date=2024-05-29;committer=xuwei09") \
      .get_remote_embedding_lite(
        kess_service = "grpc_hotMcEmbed",
        shard_num = 8,
        id_converter = {"type_name": "kuibaEmbeddingIdConverter"},
        input_attr_name = "topk_mgs_embedding_source_pids",
        output_attr_name = "session_ssd_mc_embeddings",
        query_source_type = "common_attr",
        size = 128,
        client_side_shard = True
      ) \
    .end_if_() \
    .if_("enable_fullrank_pfintr_norm_score == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .enrich_attr_by_light_function(
        import_common_attr=[
          "fullrank_pfintr_norm_watchtime_max",
        ],
        import_item_attr=[
          "fullrank_sim_pfintr"
        ],
        export_item_attr=[
          "fullrank_pfintr_norm_score"
        ],
        function_name="CalTransWatchtime",
        class_name="ExploreLightFunctionSetV2",
      ) \
    .end_if_() \
    .if_("fountain_dpp_enable_gen_next_model == 1 or fountain_dpp_enable_point_model_ltr_score == 1", to_be_delete = "date=2024-05-29;committer=caoying03") \
      .next_model() \
    .end_if_() \
    .if_("fountain_enable_use_more_user_attr == 1") \
      .explore_rerank_attr(
        user_info_attr="userInfoPb"
      ) \
      .explore_common_user_feature_enricher(
        user_info_attr="userInfoPb",
        user_realshow_action_attr="realshow_",
        user_action_list_long_version_attr="uActionListLongVersion",
        user_view_pids_attr="uViewPidListV1",
        user_view_aids_attr="uViewAidListV1",
        user_effective_view_label_attr="uEffectiveViewLabelListV1",
        user_long_view_label_attr="uLongViewLabelListV1",
        user_short_view_label_attr="uShortViewLabelListV1",
        user_view_hetu1_attr="uViewHetu1ListV1",
        user_view_hetu2_attr="uViewHetu2ListV1",
        ft_ev_pids_attr="uViewEffectivePidListV1",
        ft_lv_pids_attr="uViewLongPidListV1",
        ft_sv_pids_attr="uViewShortPidListV1",
      ) \
    .end_if_() \
    .if_("fountain_dpp_enable_gen_next_model == 1 or fountain_dpp_enable_point_model_ltr_score == 1", to_be_delete = "date=2024-05-29;committer=caoying03") \
      .next_model_handle() \
    .end_if_() \
    .if_("fountain_dpp_enable_es_queue == 1") \
      .gen_duration_xtr_score() \
    .end_if_() \
    .if_("fountain_dpp_enable_vv_es_queue == 1") \
      .gen_vv_xtr_score() \
    .end_if_() \
    .if_("fountain_dpp_enable_cid_es_queue == 1") \
      .gen_cid_xtr_score() \
    .end_if_() \
    .fullrank_attr_score() \
    .if_("fountain_dpp_enable_es_score_hetu_cal == 1 or fountain_dpp_enable_es_score_cid_cal == 1") \
      .gen_avg_xtr_score() \
    .end_() \
    .if_("fountain_dpp_enable_gen_unexpected_queue == 1", to_be_delete = "date=2024-05-29;committer=caoying03") \
      .gen_unexpected_queue() \
    .end_() \
    .if_("fountain_dpp_enable_gen_quality_queue == 1") \
      .gen_quality_queue() \
    .end_() \
    .if_("fountain_dpp_enable_gen_cluster_id_rate == 1", to_be_delete = "date=2024-05-29;committer=caoying03") \
      .gen_cluster_id_rate() \
    .end_() \
    .if_("fountain_rr_enable_cluster_to_cluster862 == 1", to_be_delete = "date=2024-05-29;committer=caoying03") \
      .explore_trans_sim_cluster_id_enricher(
        cluster_id_input_attr = "hetu_sim_cluster_id",
        cluster_id862_attr = "hetu_sim_cluster_id862" # mmu hetu sim cluster id 862版
      ) \
    .end_() \
    .dpp_process() \
    .if_("fountain_enable_model_mdp_gen_list == 1", to_be_delete = "date=2024-05-29;committer=xuwei09") \
      .cal_expected_value_gen_list() \
    .end_() \
    .if_("fountain_enable_gen_original_sequence == 1") \
      .gen_original_sequence(
        item_type=3,
        reason=4,
        sequence_length=6,
        random_reason=666,
        random_gen_list_topk = "{{fountain_random_gen_list_topk}}",
        random_gen_list_nums = "{{fountain_random_gen_list_nums}}",
        enable_random_gen_list="{{fountain_enable_random_gen_list}}",
        output_sequence_attr_name="generated_diversity_lists"
      ) \
    .end_() \
    .pack_common_attr(
      input_common_attrs=["retrieval_list_keys_6", "retrieval_list_keys_4", "retrieval_list_keys_666", "retrieval_list_keys_9"],
      output_common_attr='retrieval_list_keys',
      deduplicate=True
    ) \
    .enrich_attr_by_light_function(
      export_item_attr=["reason"] + ["generated_diversity_lists"],
      function_name="EmptyFunction",
      class_name="ExploreLightFunctionSetV2",
      item_list_from_attr="retrieval_list_keys"
    ) \
    .if_("fountain_enable_list_skip_dpp_rerank_distill == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .gen_list_rerank_distill() \
    .end_() \
    .if_("fountain_dpp_enable_invalid_dpp_gen_list == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .gen_list_rerank_point() \
    .end_() \
    .list_wise_seq_attr(
      upload_time_attr="upload_time",
      duration_ms_attr="duration_ms",
      hetu_level_one_attr="hetu_tag_level_info__hetu_level_one",
      hetu_level_two_attr="hetu_tag_level_info__hetu_level_two",
      hetu_level_three_attr="hetu_tag_level_info__hetu_level_three",
      hetu_level_four_attr="hetu_tag_level_info__hetu_level_four",
      hetu_level_five_attr="hetu_tag_level_info__hetu_level_five",
      item_attrs_transform_map=rerank_features,
      seq_item_attr_name="generated_diversity_lists",
      output_attrs=gen_photo_features_for_all_position_new(6),
      item_list_from_attr="retrieval_list_keys",
    ) \
    .if_("fountain_enable_use_model_gen_list == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .model_gen_list() \
    .end_() \
    .request_evaluator_model() \
    .if_("fountain_enable_rerank_ensemble_sort == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .list_ensemble_sort(
        output_attr="rerank_context",
        seq_item_attr_name="generated_diversity_lists",
        use_proportion="{{fountain_fr_rerank_ensemble_use_proportion}}",
        use_pow_rank="{{fountain_fr_rerank_ensemble_use_power_rank}}",
        fountain_enable_list_ensemble_sort=True,
        enable_use_debias_score="{{fountain_enable_use_debias_score}}",
        fountain_rerank_ensemble_list_weight="{{fountain_fr_rerank_ensemble_list_weight}}",
        queues=[
          {
            "name": "fullrank_sim_pfintr",
            "weight_base": "{{fountain_rerank_ensemble_sort_fintr_weight}}"
          },
          {
            "name": "fullrank_act_wtd",
            "weight_base": "{{fountain_rerank_ensemble_sort_wtd_weight}}"
          },
          {
            "name": "fullrank_ensemble_score",
            "weight_base": "{{fountain_rerank_ensemble_sort_ensemble_score_weight}}"
          },
          {
            "name": "fullrank_click_score",
            "weight_base": "{{fountain_rerank_ensemble_sort_click_weight}}"
          },
          {
            "name": "fullrank_like_score",
            "weight_base": "{{fountain_rerank_ensemble_sort_like_weight}}",
          },
          {
            "name": "fullrank_follow_score",
            "weight_base": "{{fountain_rerank_ensemble_sort_follow_weight}}",
          }
        ],
        item_list_from_attr="retrieval_list_keys"
      ) \
    .end_() \
    .sort(
      score_from_attr="rerank_context",
      item_list_from_attr="retrieval_list_keys",
    ) \
    .set_attr_value(
      no_overwrite=True,
      common_attrs=[
        {
          "name": "reason_set",
          "type": "int_list",
          "value": [0,1,2,3,4,5,10]
        }
      ]
    ) \
    .list_wise_item_attr(
      seq_item_attr_name="generated_diversity_lists",
      seq_score_attr_name="rerank_context",
      item_list_from_attr="retrieval_list_keys",
      list_reason="list_reason",
      input_seq_predict_name="eval_pred_list",
      output_item_predict_name="eval_pred_itemkey",
      reason_set="reason_set"
    ) \
    .set_attr_value(
      no_overwrite=True,
      item_attrs=[
        {
          "name": "virtual_rerank_score",
          "type": "double",
          "value": 0.0
        }, 
        {
          "name": "eval_pred_itemkey",
          "type": "double_list",
          "value": []
        },
      ],
      common_attrs=[
        {
          "name": "list_reason",
          "type": "int",
          "value": -1
        }
      ]
    ) \
    .sort(
      name = "fountain_rr",
      traceback = True,
      stable_sort=True,
      score_from_attr="virtual_rerank_score",
    ) \
    .if_("fountain_enable_final_es_sort_point == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
      .final_es_sort() \
    .end_() \
    .if_("fountain_enable_cascade_distill_sample == 1") \
      .distill_sample() \
    .end_if_() \
    .if_("fountain_enable_cascade_distill_full_link_sample == 1") \
      .full_link_distill_sample() \
    .end_if_() \
    .end_if_() \
    .copy_item_meta_info(
      save_item_seq_to_attr = "rerank_final_index",
    ) \
    .if_("fountain_enable_rerank_write_rerank_neg_result_to_redis == 1", to_be_delete = "date=2024-05-29;committer=liuhao07") \
      .write_rerank_neg_result_to_redis() \
    .end_() \
    .if_("fountain_enable_rerank_write_rerank_pos_result_to_redis == 1") \
      .write_rerank_pos_result_to_redis() \
    .end_() \
    .perflog_reason_count(
      check_point="rerank_finish",
      range_end="{{request_num}}"
    ) \
    .post_process() \
    .truncate(size_limit = "{{return page_size * 5}}") \
    .if_("enable_insert_fountain_fullrank_similar_photo == 1") \
      .explore_similar_photo_enricher(
        hetu_attr_list = ["hetu_tag_level_info_v2__hetu_level_one", "hetu_tag_level_info_v2__hetu_level_two", 
                          "hetu_tag_level_info_v2__hetu_level_three", "hetu_tag_level_info_v2__hetu_level_four"],
        author_str_list = ["author__category_detail__fourth_level_id", "author__category_detail__third_level_id"],
        face_id_attr = "hetu_tag_level_info_v2__hetu_face_id",
        hetu_tag_attr ="hetu_tag_level_info_v2__hetu_tag",
        cluster_id_attr = "hetu_tag_level_info_v2__hetu_cluster_id",
        fullrank_pid_list_attr = "fullrank_total_photo_id_list",
        enable_filter_invalid_hetu_id = "{{enable_filter_fountain_fullrank_invalid_hetu_id}}",
        skip_match_hetu_level_one = "{{skip_fountain_fullrank_match_hetu_level_one}}",
        related_score_threshold = "{{fountain_fullrank_related_score_threshold}}",
        save_total_similar_pid_list_to_attr = "similar_pid_list",
        save_similar_pid_mark_to_attr = "relative_photo_original_id",
      ) \
      .retrieve_by_common_attr(attr="similar_pid_list", reason=729563, reset_existing_item_attrs = False) \
      .count_reco_result(save_count_to = "similar_pid_retr_count", target_reason = 729563) \
      .perflog_attr_value(
        check_point="relative_photo",
        common_attrs=[
          "similar_pid_retr_count",
        ],
      ) \
    .end_if_() \
    
    return self

  def request_evaluator_model(self):
    self \
    .if_("fountain_skip_rerank_predict_v2 == 0") \
      .list_item_predict(
        kess_service = "{{fountain_rerank_kess_service_v2_produce_v4}}",
        service_group = "PRODUCTION",
        origin_seq_reason = "{{fountain_rerank_origin_reason}}",
        timeout_ms = "{{fountain_rerank_predict_timeout_ms}}",
        layer_name = "{{fountain_rerank_predict_layer_name}}",
        loss_name = "{{fountain_rerank_predict_loss_name}}",
        shard_num = "{{fountain_rerank_predict_shard_num}}",
        output_attr = "rerank_context",
        output_list_attr = "rerank_item_score",
        disable_common_attr_missing_warning = True,
        use_odd_score = "{{fountain_rerank_predict_use_odd_score}}",
        enable_use_kai = "{{fountain_rerank_predict_use_kai}}",
        use_dev_score = "{{fountain_rerank_predict_use_dev_score}}",
        dev_alpha = "{{fountain_rerank_predict_dev_alpha}}",
        dev_beta = "{{fountain_rerank_predict_dev_beta}}",
        use_product_score = "{{fountain_rerank_predict_use_product_score}}",
        use_pos_discount = "{{fountain_rerank_predict_use_pos_discount}}",
        pos_reward_str = "{{fountain_rerank_predict_pos_reward_str}}",
        rerank_list_next_weight = "{{fountain_rerank_list_next_weight_new}}",
        rerank_list_ltr_weight = "{{fountain_predict_rerank_list_ltr_weight}}",
        enable_use_list_score = "{{fountain_rerank_enable_use_list_score}}",
        item_next_attr = "{{fountain_rerank_item_next_score_attr}}",
        enable_use_pos_context_score = "{{fountain_rerank_fast_enable_pos_context}}",
        last_coeff = "{{fountain_rerank_fast_last_coeff}}",
        enable_use_pos_next_multiply = "{{fountain_rerank_fast_enable_pos_next}}",
        enable_use_pos_next_add = "{{fountain_rerank_fast_enable_pos_next_add}}",
        pos_next_cut = "{{fountain_rerank_fast_pos_next_cut}}",
        pos_next_weight = "{{fountain_rerank_fast_pos_next_weight}}",
        enable_use_bellman_equation = "{{fountain_rerank_enable_use_bellman_equation}}",
        enable_use_mul_target = "{{fountain_rerank_enable_use_mul_target}}",
        mul_target_weight_pos = "{{fountain_rerank_mul_target_weight_one}}",
        mul_target_weight_next = "{{fountain_rerank_mul_target_weight_two}}",
        mul_target_weight_play = "{{fountain_rerank_mul_target_weight_three}}",
        mul_target_weight_raw_pos = "{{fountain_rerank_mul_target_weight_raw_pos}}",
        mul_target_weight_raw_next = "{{fountain_rerank_mul_target_weight_raw_next}}",
        mul_target_weight_raw_play = "{{fountain_rerank_mul_target_weight_raw_play}}",
        mul_target_weight_raw_pow_pos = "{{fountain_rerank_mul_target_weight_raw_pow_pos}}",
        mul_target_weight_raw_pow_next = "{{fountain_rerank_mul_target_weight_raw_pow_next}}",
        mul_target_weight_raw_pow_play = "{{fountain_rerank_mul_target_weight_raw_pow_play}}",
        enable_user_list_score = "{{fountain_rerank_enable_user_list_score}}",
        list_score_weight_pos = "{{fountain_rerank_list_score_weight_pos}}",
        list_score_weight_next = "{{fountain_rerank_list_score_weight_next}}",
        list_score_weight_play = "{{fountain_rerank_list_score_weight_play}}",
        enable_use_ensemble_sort = "{{fountain_rerank_use_ensemble_sort}}",
        item_list_from_attr="retrieval_list_keys",
        attr_name_transform_map = rerank_feature_map,
        item_attrs = gen_photo_features_for_all_position_new(6),
        output_pred_val_attr = "eval_pred_list",
      ) \
    .else_() \
      .if_("fountain_skip_rerank_predict_with_new_attr == 1", to_be_delete = "date=2024-05-29;committer=huzengyi") \
        .common_predict(
          loss_function_name = ["pos" + str(i) for i in range(6)] + ["next" + str(i) for i in range(6)] + ["wtd" + str(i) for i in range(6)],
          loss_default_value = 0.0,
          kess_service = "{{fountain_rerank_kess_service_v2_produce_v4}}",
          service_group = "PRODUCTION",
          timeout_ms = 100,
          item_attrs = gen_photo_features_for_all_position_new(6),
          attr_name_transform_map = rerank_feature_map_all,
          item_list_from_attr = "retrieval_list_keys"
        ) \
        .explore_listwise_score_enricher(
          item_attrs = ["pos" + str(i) for i in range(6)] + ["next" + str(i) for i in range(6)] + ["wtd" + str(i) for i in range(6)],
          seq_item_attr_name = "generated_diversity_lists",
          loss_name = "{{fountain_rerank_predict_loss_name}}",
          output_attr = "rerank_context",
          item_list_from_attr = "retrieval_list_keys"
        ) \
      .else_() \
        .if_("fountain_rerank_eval_add_extra_attr_predict == 1") \
          .get_kconf_params(
            kconf_configs = [
            {
              "kconf_key": "{{fountain_rr_play_watch_table_kconf}}",
              "value_type": "json",
              "json_path": "durationQuantile",
              "export_common_attr": "fountain_rr_wtd_table_seg"

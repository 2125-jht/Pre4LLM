        "dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score_addAndMul": "emp_ptr_factor * dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score_addAndMul",
        "dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score_addAndMul": "emp_ftr_factor * dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score_addAndMul",
        "dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score_addAndMul": "emp_epstr_factor * dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score_addAndMul",
      }
    ) \
    .if_("fountain_rerank_enable_request_pxtr_adjust == 1") \
      .gen_common_attr_by_lua(
        attr_map={
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_like_score": "rank_boost_pltr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_like_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_follow_score": "rank_boost_pwtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_follow_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_comment_score": "rank_boost_pcmtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_comment_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score": "rank_boost_pptr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score": "rank_boost_pftr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score": "rank_boost_pepstr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_click_score": "rank_boost_pevtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_click_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_lvtr_ori_score": "rank_boost_plvtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_lvtr_ori_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_pfintr_score": "rank_boost_pfintr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_pfintr_score",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_like_score_addAndMul": "rank_boost_pltr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_like_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_follow_score_addAndMul": "rank_boost_pwtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_follow_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_comment_score_addAndMul": "rank_boost_pcmtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_comment_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score_addAndMul": "rank_boost_pptr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_profile_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score_addAndMul": "rank_boost_pftr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_forward_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score_addAndMul": "rank_boost_pepstr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_pepstr_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_click_score_addAndMul": "rank_boost_pevtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_click_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_lvtr_ori_score_addAndMul": "rank_boost_plvtr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_lvtr_ori_score_addAndMul",
          "dpp_fountain_rerank_gen_seed_ensemble_fullrank_pfintr_score_addAndMul": "rank_boost_pfintr * dpp_fountain_rerank_gen_seed_ensemble_fullrank_pfintr_score_addAndMul",
        }
      ) \
    .end_()

    return self

  def next_model(self):
    self \
    .delegate_enrich(
      kess_service = "{{fountain_rerank_gen_next_service}}",
      recv_item_attrs = [
        {"name": "point_pos", "as": "rerank_gen_point_pos"},
        {"name": "point_next", "as": "rerank_gen_point_next"},
      ],
      timeout_ms = 100,
      send_item_attrs = rr_photo_features,
      send_common_attrs = rr_user_feature,
      request_type = "{{fountain_rerank_deep_next_request_type}}",
      partition_size = "{{fountain_rerank_deep_next_partition_size}}",
    ) \

    return self

  def next_model_handle(self):
    self \
    .enrich_attr_by_light_function(
      import_common_attr=[
        "fountain_rerank_duration_adjust_param",
        "fountain_rerank_duration_adjust_level",
      ],
      import_item_attr=[
        "rerank_gen_point_pos",
        "rerank_gen_point_next",
        "duration_ms",
      ],
      export_item_attr=[
        "fullrank_rerank_gen_point_pos_score",
        "fullrank_rerank_gen_point_next_score"
      ],
      function_name="ModelQueueTrans",
      class_name="ExploreLightFunctionSetV2",
    )

    return self

  def enrich_fulllink_kai2_feature(self):
    self \
    .explore_custom_trim_user_info(
        user_info_attr = "userInfo",
        save_trimed_user_info_to_attr = "rerank_deep_ltr_trimmed_user_info",
        trim_user_info = [
          "active_days",
          "basic_info.age_segment",
          "location.city_id",
          "location.region_type",
          "client_id",
          "device_id",
          "gender",
          "infer_gender",
          "true_gender",
          "request_location.poi_type",
          "request_location.province_id",
          "request_location.city_id",
          "visit_mod",
          "user_profile.exp_stat.exp_click",
          "user_profile.exp_stat.exp_like",
          "user_profile.exp_stat.exp_follow",
          "user_profile.exp_stat.exp_realshow",
          "user_profile.exp_stat.exp_long_view",
          "user_profile.user_level",
          "realtime_click_list",
          "realtime_follow_list",
          "realtime_forward_list",
          "realtime_like_list",
        ],
      )
    return self
  

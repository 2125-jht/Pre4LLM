def get_dpp_rule_dict():
  rule = [
    dict(attr_name= "duration_0_7s",
          enabled="{{fountain_rerank_variety_enable_dura_0_7}}",
          window_size="{{fountain_rerank_variety_winsize_dura_0_7}}",
          max_num="{{fountain_rerank_variety_maxnum_dura_0_7}}",
          priority="{{fountain_rerank_variety_priority_dura_0_7}}"),    
    dict(attr_name= "author__id",
          enabled="{{fountain_rerank_variety_enable_author_id}}",
          window_size= "{{fountain_rerank_variety_author_id_window_size}}",
          max_num="{{fountain_rerank_variety_author_id_max_num}}",
          priority="{{fountain_rerank_variety_author_id_priority}}"),
    dict(attr_name= "hetu_tag_level_info__hetu_level_one",
          enabled="{{fountain_rerank_variety_enable_hetu_level_one}}",
          window_size="{{fountain_rerank_variety_hetu_level_one_winsize}}",
          window_type="{{fountain_rerank_variety_hetu_level_one_wintype}}",
          max_num="{{fountain_rerank_variety_hetu_level_one_max}}",
          priority="{{fountain_rerank_variety_hetu_level_one_priority}}"),
    dict(attr_name= "hetu_tag_level_info__hetu_level_five",
          enabled="{{fountain_rerank_variety_enable_hetu_level_five}}",
          window_size= "{{fountain_rerank_variety_hetu_level_five_winsize}}",
          max_num="{{fountain_rerank_variety_hetu_level_five_max}}",
          priority="{{fountain_rerank_variety_hetu_level_five_priority}}"),
    dict(attr_name = "is_marketing_compensation_photo",
          enabled = "{{fountain_rerank_enable_marketing_compensation_photo_diversity}}",
          window_size = "{{fountain_rerank_marketing_compensation_photo_diversity_winsize}}",
          max_num = "{{fountain_rerank_marketing_compensation_photo_diversity_max_num}}",
          priority = "{{fountain_rerank_marketing_compensation_photo_diversity_priority}}"),
    dict(attr_name = "is_minority_photo",
          enabled = "{{enable_fountain_rerank_minority_photo_diversity}}",
          window_size = "{{fountain_rerank_minority_photo_diversity_winsize}}",
          max_num = "{{fountain_rerank_minority_photo_diversity_max_num}}",
          min_num = "{{fountain_rerank_minority_photo_diversity_min_num}}",
          priority = "{{fountain_rerank_minority_photo_diversity_priority}}")
  ]
  return rule

def rerank_extra_common_attr():
  features = [
    "uViewPidListV1",
    "uViewAidListV1",
    "uEffectiveViewLabelListV1",
    "uLongViewLabelListV1",
    "uShortViewLabelListV1",
    "uViewHetu1ListV1",
    "uViewHetu2ListV1",
    "uViewEffectivePidListV1",
    "uViewLongPidListV1",
    "uViewShortPidListV1",
    "uBasicGender",
  ]
  for i in range(30):
    for suffix in ["", "aid_", "tag_", "play_"]:
      features.append("realshow_" + suffix + str(i))
  return features


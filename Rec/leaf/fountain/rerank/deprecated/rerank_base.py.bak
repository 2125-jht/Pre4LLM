def gen_variant_config():
    return {
        "default_decay_rate": 0.1,
        "default_decay_window_size": 6,
        "default_decay_occurrent_times": 3,
        "author__id": {
          "decay_occurrent_times": 3,
          "decay_window_size": 6
        },
    }

def gen_beamsearch_filter_queues():
    res = []
    queues = ["click", "like", "follow", "forward", "comment", "profile", "longview",
              "watchtime", "shortview", "l2r", "pepstr", "outctr", "shortviewinorder", "neg_feedback_discount",
              "watchtime_ori", "fusion_pctr", "fusion_pcltr"]
    prefix = "{{fountain_rerank_beamsearch_filter_"
    for i, q in enumerate(queues) :
      t = {"name" : "fullrank_" + q + "_score"}
      t.update({"weight_base" : prefix + q + '_score}}'})
      res.append(t)
    return res

def gen_list_ensemble_filter_queues():
    res = []
    queues = ["click", "like", "follow", "forward", "comment", "profile", "longview",
              "watchtime", "shortview", "l2r", "pepstr", "outctr", "shortviewinorder", "neg_feedback_discount",
              "watchtime_ori"]
    prefix = "{{fountain_rerank_list_ensemble_filter_"
    for i, q in enumerate(queues) :
      t = {"name" : "fullrank_" + q + "_score"}
      t.update({"weight_base" : prefix + q + '_score}}'})
      res.append(t)
    return res

def gen_seed_ensemble_queues_dpp_v2():
  res = []
  queues = ["click", "like", "follow", "forward", "comment", "profile", "longview",
            "watchtime", "shortview", "l2r", "pepstr", "outctr", "shortviewinorder", "neg_feedback_discount",
            "watchtime_ori", "evtr_v2", "lstr", "collect", "cmef", "lvtr_ori", "pfintr", "finish", "next", "slide", "opportunity_cost",
            "cl_tran", "ada_xtr", "trans_pvtr", "act_ctr", "topk_mgs_expected", "action_once_interact", "action_once_watchtime", "pcpr",
            "act_wtd", "pure_value", "fusion_pctr", "fusion_pcltr", "cl", "cascade_linear", "cl_play_time", "satisfy", "rank_before_rerank","rerank_gen_point_pos", "rerank_gen_point_next","rrwtd","rrnext", "min_act_rank_reci",
            "ori_pswptr", "distill_rerank", "lt_interest", "comment_ltr", "xgb_ltr", "hate_similary", "pre_filter", "unexpected", "shortview_phtr",
            "pctr_hetu", "pltr_hetu", "pwtr_hetu", "pftr_hetu", "pcmtr_hetu", "pptr_hetu", "rerank_distill", "evtr_distill", "distill_fusion", "triplem", "triplem_interaction", 
            "merchant_photo_ctcvr", "merchant_photo_gmv", "merchant_live_ctcvr", "merchant_live_gmv", "fractile_fusion", "hetu_behavior", "duration_pxtrs", "vv_pxtrs", "cid_pxtrs", "quality_time", "quality_action", "quality_play",
            "produce_new_user_clk", "produce_new_user_ups", "produce_month_user_clk", "produce_month_user_ups", "produce_weeks_user_clk", "produce_weeks_user_ups", "produce_week_user_clk", "produce_week_user_ups",
            "user_author_ltv", "user_author_ltv_time", "esnn", "ctr_kelly_gain", "interact_kelly_gain", "session", "quantile_relative", "wtd_by_frac", "wtd_by_frac_evtr", "wtd_by_frac_lvtr", "wtd_by_frac_svtr", "wtd_by_frac_cpr",
            "effective_follow_rate", "effective_follow_value", "good_item_similary"]
  prefix = "{{dpp_fountain_rerank_gen_seed_ensemble_fullrank_"
  for i, q in enumerate(queues) :
    t = {"name" : "fullrank_" + q + "_score"}
    t.update({"weight_base" : prefix + q + '_score}}'})
    t.update({"weight_addAndMul": prefix + q + '_score_addAndMul}}'})
    t.update({"bias_range" : prefix + q + '_range}}'})
    t.update({"weight_lower_bound" : prefix + q + '_lower_bound}}'})
    t.update({"enable_use_proportion" : prefix + q + '_use_proportion}}'})
    t.update({"raw_weight" : prefix + q + '_raw_weight}}'})
    t.update({"raw_pow_weight" : prefix + q + '_raw_pow_weight}}'})
    t.update({"raw_weight_multiply" : prefix + q + '_raw_weight_multiply}}'})
    t.update({"raw_pow_weight_multiply" : prefix + q + '_raw_pow_weight_multiply}}'})
    t.update({"que_discount_coef" : prefix + q + '_que_discount_coef}}'})
    t.update({"raw_weight_addAndMul" : prefix + q + '_raw_weight_addAndMul}}'})
    t.update({"raw_pow_weight_addAndMul" : prefix + q + '_raw_pow_weight_addAndMul}}'})
    t.update({"raw_score_alpha": prefix + q + '_raw_score_alpha}}'})
    t.update({"score_norm": prefix + q + '_score_norm}}'})
    if (q == "collect") :
      t.update({"variant_weight" : "{{fountain_rerank_cltr_score_variant_weight}}"})
    if (q in ("like", "collect", "comment", "follow", "forward", "click", "pfintr", "outctr", "evtr_v2")) :
      t.update({"fractile_name": "fullrank_" + q + '_fractile_score'})
      t.update({"raw_weight_fractile" : prefix + q + '_raw_weight_fractile}}'})
      t.update({"raw_pow_weight_fractile" : prefix + q + '_raw_pow_weight_fractile}}'})
    res.append(t)

  queues_v2 = ["fullrank_sim_playtime_finish", "fullrank_sim_ordinal_playtime", "fullrank_sim_evtr_playtime",
               "fullrank_sim_evtr_duration", "fullrank_sim_wtd_duration", "topk_mgs_neg_score", "fullrank_sim_phtr", "fullrank_distill_rerank_ltr",
               "fullrank_fractile_sum_score", "fr_duration_xtr_bias_score", "fullrank_sim_living_pctr", "fullrank_ltr_v4_fountain_ordinal_wtd",
              "fullrank_ltr_v4_short_view", "fullrank_ltr_v4_log_playtime", "fr_living_ctr", "fr_living_lwtr", "fr_living_gtr", "fr_living_mix_score",
              "high_quality_follow_rate_score", "implicit_follow_rate_score"]
  prefix = "{{dpp_fountain_rerank_gen_seed_ensemble_fullrank_"
  for i, q in enumerate(queues_v2) :
    t = {"name" : q}
    t.update({"weight_base" : prefix + q + '_score}}'})
    t.update({"weight_addAndMul": prefix + q + '_score_addAndMul}}'})
    t.update({"bias_range" : prefix + q + '_range}}'})
    t.update({"weight_lower_bound" : prefix + q + '_lower_bound}}'})
    t.update({"enable_use_proportion" : prefix + q + '_use_proportion}}'})
    t.update({"raw_weight" : prefix + q + '_raw_weight}}'})
    t.update({"raw_pow_weight" : prefix + q + '_raw_pow_weight}}'})
    t.update({"raw_weight_multiply" : prefix + q + '_raw_weight_multiply}}'})
    t.update({"raw_pow_weight_multiply" : prefix + q + '_raw_pow_weight_multiply}}'})
    t.update({"que_discount_coef" : prefix + q + '_que_discount_coef}}'})
    t.update({"raw_weight_addAndMul" : prefix + q + '_raw_weight_addAndMul}}'})
    t.update({"raw_pow_weight_addAndMul" : prefix + q + '_raw_pow_weight_addAndMul}}'})
    t.update({"raw_score_alpha": prefix + q + '_raw_score_alpha}}'})
    t.update({"score_norm": prefix + q + '_score_norm}}'})
    res.append(t)

  return res

def gen_splash_seed_ensemble_queues():
    res = []
    queues = ["click", "like", "follow", "forward", "comment", "profile", "longview",
              "watchtime", "shortview", "l2r", "pepstr", "outctr", "shortviewinorder", "neg_feedback_discount",
              "watchtime_ori", "evtr_v2", "lstr", "collect", "cmef", "lvtr_ori", "pfintr", "finish", "next", "slide",
              "cl", "act_ctr", "fusion_pctr", "fusion_pcltr", "cl_play_time"]
    prefix = "{{fountain_splash_rerank_gen_seed_ensemble_fullrank_"
    for i, q in enumerate(queues) :
      t = {"name" : "fullrank_" + q + "_score"}
      t.update({"weight_base" : prefix + q + '_score}}'})
      t.update({"bias_range" : prefix + q + '_range}}'})
      t.update({"weight_lower_bound" : prefix + q + '_lower_bound}}'})
      t.update({"enable_use_proportion" : prefix + q + '_use_proportion}}'})
      res.append(t)

    queues = ["duration_0_7s", "duration_7_9s", "duration_9_12s", "duration_12_17s",
              "duration_17_20s", "duration_20_58s", "duration_gt_58s", "duration_gt_120s", "source_related_score"]
    prefix = "{{fountain_splash_rerank_gen_seed_ensemble_"
    for i, q in enumerate(queues) :
      t = {"name" : q}
      t.update({"weight_base" : prefix + q + '_score}}'})
      t.update({"bias_range" : prefix + q + '_range}}'})
      res.append(t)

    return res


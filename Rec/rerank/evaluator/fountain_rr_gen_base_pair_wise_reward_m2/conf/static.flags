#!/bin/bash

# 向下游输出的速率限制
--base_bt_queue_client_push_limit=30000000
--base_bt_queue_use_kess_route_table=true
# 模型大，所有feature 均匀分布到所有shard
--all_embedding_feature=true
--use_kuiba_sign_slot=1
--evenly_distribute_feature_to_btq_shards=1
--is_embedding_output_1024=0
#--parameter_config_json_file=data/nearby_photo_fr_prod_v6_finish.json
--logbuflevel=-1
--write_feature_without_version_check=1
--ks_push_meta=false
--mio_kafka_decode_threads=16
#--kuiba_click_label=click,like,follow,long_view,finish,play
#--mio_tensorflow_executor_session_per_device=64
--extra_slot_btq_conf=
#--kuiba_use_label_value=true
--mio_write_dnn_model_as_macro_block=true
--add_emp_auc_eval=false
--kuiba_sample_channel_sharding_policy=2
#--logging_switch_uid_mod_divisor=1000
--logging_switch_uid_mod_divisor=19999
#--log_dir=./log/
#--log_dir=YARN_LOG_DIR
--ip_region_dict_file=./data/ip_region.dat
--mio_tensorflow_executor_session_per_device=1
--mio_tensorflow_gpu_device_memory_mb=14000
--log_device_placement=true
--socket_max_unwritten_bytes=268435456
--load_model_threads=4

--bthread_concurrency=48
--use_batched_samples=false
#--embedding_warmup_with_mio_model=true
#--parameter_sign_bits=48
--duplicate_slot_behavior=2
--hdfs_read_sort_file_by_time=false
--auc_chan_capacity=2000000
--mode=train
--use_tensor_cache=true
--thread_bind_session=true
--wait_data_before_pass=true
--use_g2sum_per_dim=true
--check_shrink_interval_pass=10
--dnn_push_prob=0.2
--use_kai_learner=true
--max_body_size=750696490
--parse_thread_num=4
--common_leaf_offline_fetcher_hdfs_fetcher=mio
--mio_tensorflow_inter_op_parallelism_threads=4
--mio_tensorflow_intra_op_parallelism_threads=4
--force_padding_grad=false
--truncate_expand=true
--req_retry_times=999
--kess_client_event_loop_nums=32
--total_btqueue_shards=2
--init_done_file=./conf/done_list
--init_load_dense_path=/
--init_load_sparse_path=/
--kuiba_sparse_slot_mapping_filename=./conf/kai_kuiba_config.json
--kuiba_sparse_parameter_key_type_bit=10
--sparse_model_loader_consumer_nums=4
--model_key=fountain_rr_gen_base_pair_wise_reward_m2
